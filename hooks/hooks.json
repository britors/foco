{
  "description": "Aplicam o modo foco da sessão (ligado e desligado só pelo usuário, com /foco on e /foco off), lembram os itens pendentes a cada pedido, avisam edições fora do escopo e não deixam encerrar com item pendente. Mostram \"foco ativo\" ou \"foco ligado\" na status line.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/foco/scripts/foco.py\" hook-inicio",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/foco/scripts/foco.py\" hook-lembrete",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/foco/scripts/foco.py\" hook-guarda",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/foco/scripts/foco.py\" hook-escopo",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/foco/scripts/foco.py\" hook-parar",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./status.ts"
  ]
}
